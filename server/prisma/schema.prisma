// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ShipmentStatus {
  OPEN
  MATCHED
  HANDED_OVER
  ON_WAY
  DELIVERED
  CANCELLED
}

enum PackageType {
  PACKAGE
  DOCUMENT
  ENVELOPE
  BOX
}

enum MessageCategory {
  TEXT
  SYSTEM
  MATCH_REQUEST
  MATCH_ACCEPTED
  OFFER
}

enum TransactionStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TravelStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  PENDING
  ACTIVE
  MATCHED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id          String    @id // Firebase UID
  email       String    @unique
  
  // Personal Info
  firstName   String?
  lastName    String?
  
  // Contact
  phone       String?
  phoneCode   String?
  
  // Birthday
  dateOfBirth DateTime?
  
  // Location
  country     String?
  countryCode String?
  city        String?
  
  // Profile
  avatar      String?
  bio         String?
  
  // Verification
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  documentUrl        String?
  selfieUrl          String?
  
  // Session
  lastLoginAt        DateTime?
  
  // Timestamps
  joinedAt    DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt

  // Relations
  shipmentsAsSender   Shipment[] @relation("SenderShipments")
  shipmentsAsCourier  Shipment[] @relation("CourierShipments")
  offers              ShipmentOffer[]
  travels             Travel[]   @relation("TravelerTrips")
  
  // Chat relations
  conversationsAsUser1  Conversation[] @relation("ConversationUser1")
  conversationsAsUser2  Conversation[] @relation("ConversationUser2")
  messagesSent          Message[]
  
  // Payment relations
  paymentMethods        PaymentMethod[]
  transactionsAsPayer   Transaction[] @relation("PayerTransactions")
  transactionsAsPayee   Transaction[] @relation("PayeeTransactions")
  
  // Reviews
  reviewsReceived       UserReview[]  @relation("Reviewee")
  reviewsGiven          UserReview[]  @relation("Reviewer")
}

model Shipment {
  id              String    @id @default(cuid())
  
  // Route - Origin
  originCountry   String
  originCity      String
  originAddress   String?
  
  // Route - Destination
  destCountry     String
  destCity        String
  destAddress     String?

  
  // Package Details
  weight          Float     // in kg
  weightUnit      String    @default("kg")
  content         String
  packageType     PackageType @default(PACKAGE)
  imageUrl        String?
  
  // Delivery Window
  dateStart       DateTime
  dateEnd         DateTime
  
  // Pricing
  price           Float     // Amount in USD
  currency        String    @default("USD")
  
  // Sender Details (for finalization)
  senderFullName  String?
  senderIdNumber  String?
  senderAge       Int?
  senderPhone     String?
  senderPhoneCode String?
  
  // Status
  status          ShipmentStatus @default(OPEN)
  
  // Confirmation tracking - Both parties must confirm
  senderConfirmedHandover   Boolean   @default(false)
  courierConfirmedHandover  Boolean   @default(false)
  senderConfirmedDelivery   Boolean   @default(false)
  courierConfirmedDelivery  Boolean   @default(false)
  
  // Confirmation timestamps
  handoverConfirmedAt       DateTime?
  deliveryConfirmedAt       DateTime?
  
  // Handover Info
  senderHandoverImageUrl    String?
  courierHandoverImageUrl   String?
  
  // Reviews
  reviews                   UserReview[]

  // Relations
  senderId        String
  sender          User      @relation("SenderShipments", fields: [senderId], references: [id])
  
  courierId       String?
  courier         User?     @relation("CourierShipments", fields: [courierId], references: [id])
  
  offers          ShipmentOffer[]
  conversations   Conversation[]
  transaction     Transaction?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([senderId])
  @@index([courierId])
  @@index([status])
  @@index([dateStart, dateEnd])
}

model ShipmentOffer {
  id          String    @id @default(cuid())
  
  // Offer Details
  message     String
  counterPrice Float?    // Sender's counter-proposed price (null if no counter-offer)
  
  // Status
  status      OfferStatus @default(PENDING)
  
  // Relations
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  courierId   String
  courier     User      @relation(fields: [courierId], references: [id])
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shipmentId])
  @@index([courierId])
}

// Travelers posting their upcoming trips
model Travel {
  id              String    @id @default(cuid())
  
  // Route - From
  fromCountry     String
  fromCity        String
  fromAirport     String?
  fromAirportCode String?
  
  // Route - To
  toCountry       String
  toCity          String
  toAirport       String?
  toAirportCode   String?
  
  // Travel Date
  departureDate   DateTime
  arrivalDate     DateTime?
  
  // Capacity
  availableWeight Float     // in kg
  weightUnit      String    @default("kg")
  
  // Pricing Expectation
  pricePerKg      Float?    // Price per kg willing to carry
  currency        String    @default("USD")
  
  // Flight details (optional)
  flightNumber    String?
  
  // Status
  status          TravelStatus @default(ACTIVE)
  
  // Relations
  travelerId      String
  traveler        User      @relation("TravelerTrips", fields: [travelerId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([travelerId])
  @@index([status])
  @@index([departureDate])
  @@index([fromCity, toCity])
}

// Conversations between users about a shipment
model Conversation {
  id          String    @id @default(cuid())
  
  // Participants
  user1Id     String    // Usually the sender (shipment owner)
  user1       User      @relation("ConversationUser1", fields: [user1Id], references: [id])
  
  user2Id     String    // Usually the courier (interested party)
  user2       User      @relation("ConversationUser2", fields: [user2Id], references: [id])
  
  // Related shipment
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  // Conversation status: PENDING (courier waiting for owner), ACTIVE (owner responded), MATCHED (deal confirmed)
  status      ConversationStatus @default(PENDING)
  
  // Last message preview
  lastMessage String?
  lastMessageAt DateTime?
  
  // Messages
  messages    Message[]
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([user1Id, user2Id, shipmentId])
  @@index([user1Id])
  @@index([user2Id])
  @@index([shipmentId])
}

// Individual messages in a conversation
model Message {
  id              String    @id @default(cuid())
  
  // Content
  content         String
  
  // Message type
  type            MessageCategory @default(TEXT)
  
  // Read status
  isRead          Boolean   @default(false)
  
  // Relations
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// Saved payment methods
model PaymentMethod {
  id            String    @id @default(cuid())
  
  // Card details (in production, use Stripe token instead)
  cardType      String    // visa, mastercard, amex
  lastFour      String    // Last 4 digits
  cardHolder    String    // Name on card
  expiryMonth   Int
  expiryYear    Int
  
  // Is default
  isDefault     Boolean   @default(false)
  
  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  transactions  Transaction[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// Payment transactions
model Transaction {
  id              String    @id @default(cuid())
  
  // Amount
  amount          Float
  currency        String    @default("USD")
  
  // Status
  status          TransactionStatus @default(PENDING)
  description     String?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  payerId         String
  payer           User      @relation("PayerTransactions", fields: [payerId], references: [id])
  
  payeeId         String
  payee           User      @relation("PayeeTransactions", fields: [payeeId], references: [id])
  
  shipmentId      String?   @unique
  shipment        Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([payerId])
  @@index([payeeId])
  @@index([shipmentId])
  @@index([status])
}

model UserReview {
  id          String   @id @default(cuid())
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())
  
  reviewerId  String
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  
  revieweeId  String
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
